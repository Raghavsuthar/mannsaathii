<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12 (API 31) and higher.
    Explicitly excludes all domains to prevent unauthorized cloud backup
    and adb / D2D migration of patient health data and caregiver PINs.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

